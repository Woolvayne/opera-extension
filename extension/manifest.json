{
  "manifest_version": 3,
  "name": "Arena PC Bridge",
  "version": "1.0.0",
  "description": "Schaltet einen Ein/Aus-Knopf unter die Chat-Eingabe von Arena.ai: Arena darf dann auf deinem PC suchen, Dateien lesen und Befehle ausfuehren (nur lokal via 127.0.0.1).",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://arena.ai/*",
    "https://*.arena.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Arena PC Bridge",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "exclude_matches": [
        "https://arena.ai/bridge*",
        "https://*.arena.ai/bridge*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ],
      "exclude_matches": [
        "https://arena.ai/bridge*",
        "https://*.arena.ai/bridge*"
      ],
      "js": [
        "src/toggle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*"
      ]
    }
  ]
}
